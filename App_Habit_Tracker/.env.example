# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# These variables are used from phase 2 on (see docs/cuentas.md).

# Postgres for this environment: local Docker in development, a Neon branch elsewhere.
DATABASE_URL=postgres://habit:habit@localhost:5432/habit_tracker

# Signs sessions. Generate one per environment with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the API in this environment.
BETTER_AUTH_URL=http://localhost:8787

# "true" only while creating the first account; keep "false" otherwise.
AUTH_SIGNUP_ENABLED=false
