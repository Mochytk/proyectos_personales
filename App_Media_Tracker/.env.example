# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# These are SERVER-SIDE secrets (Worker secrets or .dev.vars): never put them in the frontend.
# Placeholders only; no real values here.

# TMDB (movies and series) API key.
TMDB_API_KEY=

# RAWG (games) API key.
RAWG_API_KEY=

# Postgres for this environment: local Docker in development, a Neon branch elsewhere.
DATABASE_URL=postgres://user:password@localhost:5432/media_tracker

# Signs sessions. Generate one per environment with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-up stays closed: the account is created once by hand (ADR 0003).
AUTH_SIGNUP_ENABLED=false
