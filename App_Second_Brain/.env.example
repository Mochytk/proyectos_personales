# Copy to .env.local (ignored by git) and fill in locally. Never commit real values.
# Each variable is documented where it is first used.

# Absolute path to the vault folder. It must live outside this repo.
SECOND_BRAIN_VAULT_DIR=

# Log level for local tools: error | warn | info | debug. Logs never include note content.
SECOND_BRAIN_LOG_LEVEL=info
